apiVersion: inference.opendatahub.io/v1alpha1
kind: ExternalModel
metadata:
  name: {{ model_ref_name }}
  namespace: {{ model_namespace }}
  labels:
    app.kubernetes.io/managed-by: forge
{% if owner_ref %}
  ownerReferences:
  - apiVersion: {{ owner_ref.apiVersion }}
    kind: {{ owner_ref.kind }}
    name: {{ owner_ref.name }}
    uid: {{ owner_ref.uid }}
{% endif %}
spec:
  modelName: {{ external_target_model }}
  externalProviderRefs:
  - apiFormat: openai-chat
    path: /v1/completions
    targetModel: {{ external_target_model }}
    ref:
      name: {{ model_ref_name }}-provider
    auth:
      type: apikey
      secretRef:
        name: {{ model_ref_name }}-creds
