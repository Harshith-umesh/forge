apiVersion: serving.kserve.io/v1alpha1
kind: ServingRuntime
metadata:
  annotations:
    opendatahub.io/template-display-name: ServingRuntime for {{ args.engine }} | RHAIIS
  labels:
    opendatahub.io/dashboard: "true"
  name: {{ args.deployment_name }}
  namespace: {{ args.namespace }}
spec:
{%- if args.image_pull_secret %}
  imagePullSecrets:
    - name: {{ args.image_pull_secret }}
{%- if args.engine == "trtllm" %}
    - name: ngc-secret
{%- endif %}
{%- elif args.engine == "trtllm" %}
  imagePullSecrets:
    - name: ngc-secret
{%- endif %}
  builtInAdapter:
    modelLoadingTimeoutMillis: 300000
  multiModel: false
  supportedModelFormats:
    - autoSelect: true
{%- if args.engine == "sglang" %}
      name: sglang
{%- elif args.engine == "trtllm" %}
      name: trtllm
{%- else %}
      name: vLLM
{%- endif %}
  containers:
{%- if args.engine == "trtllm" %}
    - name: kserve-container
      image: "{{ args.serving_image }}"
      command:
        - /bin/bash
        - -c
        - |
          set -ex
          if [ ! -d "/mnt/models/hub/models--{{ args.model_id | replace('/', '--') }}/snapshots" ]; then
            hf download {{ args.model_id }}
          fi
          python3 -c "
          from flashinfer.norm import get_norm_module
          get_norm_module()
          print('FlashInfer norm kernel pre-compiled successfully')
          "
{%- if args.trtllm_config %}
          cat > /tmp/trtllm-config.yml << EOF
          {{ args.trtllm_config | indent(10) }}
          EOF
{%- endif %}
          trtllm-serve {{ args.model_id }} \
            --host 0.0.0.0 \
            --port={{ args.engine_port }} \
{%- for key, val in (args.engine_args or {}).items() %}
  {%- if key != "trtllm-config" %}
    {%- if val is boolean %}
      {%- if val %}
            --{{ key }} \
      {%- endif %}
    {%- else %}
            --{{ key }}={{ val }} \
    {%- endif %}
  {%- endif %}
{%- endfor %}
{%- if args.trtllm_config %}
            --extra_llm_api_options=/tmp/trtllm-config.yml
{%- endif %}

      env:
        - name: HF_HUB_OFFLINE
          value: "0"
        - name: HF_HOME
          value: /mnt/models
        - name: HF_TOKEN
          valueFrom:
            secretKeyRef:
              name: storage-config
              key: HF_TOKEN
        - name: TRTLLM_ENABLE_PDL
          value: "1"
        - name: HOME
          value: /tmp
        - name: XDG_CACHE_HOME
          value: /tmp/.cache
        - name: FLASHINFER_WORKSPACE_BASE
          value: /mnt/models
{%- for env_item in ctx.env_vars_list %}
        - name: {{ env_item.name }}
          value: "{{ env_item.value }}"
{%- endfor %}
      securityContext:
        runAsUser: 0
      ports:
        - containerPort: {{ args.engine_port }}
          protocol: TCP
      volumeMounts:
        - name: shared-memory
          mountPath: /dev/shm
  volumes:
    - name: shared-memory
      emptyDir:
        medium: Memory
        sizeLimit: 128Gi
{%- else %}
    - name: kserve-container
      image: "{{ args.serving_image }}"
      command:
{%- if args.engine == "sglang" %}
        - python3
        - -m
        - sglang.launch_server
      args:
{%- if args.storage_source == "hf" %}
        - --model-path={{ args.model_id }}
{%- else %}
        - --model-path=/mnt/models
{%- endif %}
        - --port=8080
        - --host=0.0.0.0
{%- else %}
        - python3
        - -m
        - vllm.entrypoints.openai.api_server
      args:
{%- if args.storage_source == "hf" %}
        - --model={{ args.model_id }}
{%- else %}
        - --model=/mnt/models
        - --served-model-name={{ args.model_id }}
{%- endif %}
        - --port=8080
{%- endif %}
{%- for key, val in (args.engine_args or {}).items() %}
  {%- if val is boolean %}
    {%- if val %}
        - --{{ key }}
    {%- endif %}
  {%- else %}
        - --{{ key }}={{ val }}
  {%- endif %}
{%- endfor %}
      env:
        - name: XDG_CACHE_HOME
          value: /tmp/.cache
        - name: XDG_CONFIG_HOME
          value: /tmp/.config
{%- if ctx.gpu_count > 1 %}
        - name: NCCL_DEBUG
          value: "WARN"
{%- endif %}
{%- if args.storage_source == "hf" %}
        - name: HF_HUB_OFFLINE
          value: "0"
        - name: HOME
          value: /mnt/models
        - name: HF_HOME
          value: /mnt/models
{%- if args.engine != "sglang" %}
        - name: VLLM_CACHE_DIR
          value: /mnt/models/.cache/vllm
{%- endif %}
        - name: HF_DATASETS_CACHE
          value: /mnt/models/.cache/huggingface/datasets
        - name: HF_TOKEN
          valueFrom:
            secretKeyRef:
              name: storage-config
              key: HF_TOKEN
{%- else %}
        - name: HOME
          value: /tmp
{%- endif %}
{%- for env_item in ctx.env_vars_list %}
        - name: {{ env_item.name }}
          value: "{{ env_item.value }}"
{%- endfor %}
      ports:
        - containerPort: {{ args.engine_port }}
          protocol: TCP
{%- if ctx.gpu_count > 1 %}
      volumeMounts:
        - name: shared-memory
          mountPath: /dev/shm
  volumes:
    - name: shared-memory
      emptyDir:
        medium: Memory
        sizeLimit: 64Gi
{%- endif %}
{%- endif %}
